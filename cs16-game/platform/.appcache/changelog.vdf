			"EN"
			{
				"1"		"{39ff14}~New~Added automatic client update system (can be toggled in settings)"
				"2"		"{39ff14}~New~Added 'Matchmaking' tab to 'New Game' menu for quick game search with filters (game, mod, map) (can be toggled)"
				"3"		"{39ff14}~New~Added Discord RPC integration to display in-game status"
				"4"		"{39ff14}~New~Added a button in settings to enable/disable Steam integration"
				"5"		"{39ff14}~New~Added ConVars for scoreboard customization"
				"6"		"{f08080}	• scoreboard_showsteam"
				"7"		"{f08080}	• scoreboard_showdefaultavatars"
				"8"		"{f08080}	• scoreboard_steamicon_offset_x"
				"9"		"{f08080}	• scoreboard_steamicon_offset_y"
				"10"		"{f08080}	• scoreboard_steamicon_scale"
				"11"		"{39ff14}~New~Re-introduced and completely overhauled the progressive 'lazy' loading mode for demo files:"
				"12"		"{fafafa}	• Demos now start playing immediately without waiting for the full file to load"
				"13"		"{fafafa}	• The file parsing process is now decoupled from fps_max, resulting in significantly faster buffering"
				"14"		"{fafafa}	• The progress slider now displays the full demo duration from the start, while a new indicator shows the buffered portion available for seeking"
				"15"		"{39ff14}~New~Added ConVar 'dem_force_preload' to configurable demo loading mode"
				"16"		"{fafafa}	• 0 = Enables progressive lazy loading for instant playback startup"
				"17"		"{fafafa}	• 1 = Enables full pre-loading of the demo into memory, providing full seek capabilities immediately after loading"
				"18"		"{fafafa}		This mode also significantly speeds up the total load time (especially for long demo files)"
				"19"		"{39ff14}~New~Added support for the 'ViewModelFX' custom user message (@next21)"
				"20"		"{39ff14}~New~Added support for the 'Sprite API' via the 'HudSprite' custom user message (@next21)"
				"21"		"{39ff14}~New~Added 'Fullbright' support for textures in studio models. Works only on regular models, not on player models (@256bit)"
				"22"		"{39ff14}~New~Added on-the-fly 'gl_picmip' updates without restarting the map"
				"23"		"{39ff14}~New~Added a gear settings menu to the server browser with an option to auto-open the window on startup"
				"24"		"{39ff14}~New~Added new 'cl_righthand -2' mode - legacy knife left / weapons right (classic behavior without requiring 'cl_lw 0')"
				"25"		"{39ff14}~New~Added ConVar 'cl_sync_steam_favorites' to toggle synchronization of favorite servers with Steam"
				"26"		"{39ff14}~New~Added ConVar 'spec_draw' to toggle the 'Spectator UI' (black bars) - useful for moviemaking (@metita)"
				"27"		"{39ff14}~New~Added 'Alt+Enter' support to instantly toggle between windowed and fullscreen modes (@hajimura)"
				"28"		"{39ff14}~New~Added ConVar 'sdl_enable_alt_enter' to enable 'Alt+Enter' fullscreen/windowed mode (@hajimura)"
				"29"		"{39ff14}~New~Added ConVar 'spec_menu_on_duck' to enable/disable the spectator menu (@d3stra) [youtube=1-7KoGGxAK8?t=1823]"
				"30"		"{39ff14}~New~Added Nested Clipping for transparent UI panels (CS:S style)."
				"31"		"• Prevents visual clutter by masking overlapping windows"
				"32"		"• Configurable via 'ClipPopupOverlaps' and 'ClipPopupAlphaThreshold' in scheme files"
				"33"		"{39ff14}~New~Added support for Rounded Corners in VGUI frames (customizable in scheme via 'FrameBorder')"
				"34"		"{39ff14}~New~Added '-watchscheme' launch parameter for automatic Hot Reload of VGUI schemes — updates UI immediately when theme files are modified (useful for creating themes)"
				"35"		"{39ff14}~New~Added support for 'goldclient://' protocol for server connection and listen server creation via web browser (@metita)"
				"36"		"{39ff14}~New~Added support for protocol 47 demos (@karaul0v)"
				"37"		"{39ff14}~New~Added Escape scenario support to HUD radar (@esotericdesign)"
				"38"		"{39ff14}~New~Added ConVar 'cl_cmdtickrate' to fully decouple movement physics from framerate (FPS), enforcing a consistent update tickrate regardless of FPS"
				"39"		"{39ff14}~New~Added '-gl_legacy' launch parameter to force legacy OpenGL mode for compatibility"
				"40"		"{39ff14}~New~Added country flags to the 'Favorites', 'Friends', and 'History' tabs in the server browser (@GLoOoccK)"
				"41"		"{ceff00}~Improvement~Removed dependency on the system registry, all settings are now file-based for full portability"
				"42"		"{ceff00}~Improvement~Fully reworked avatar manager: improved stability, added CDN support for fast loading"
				"43"		"{ceff00}~Improvement~Significantly optimized lookup and execution of console commands and aliases"
				"44"		"{ceff00}~Improvement~Optimized Options dialog opening, removed delays and implemented avatar list caching"
				"45"		"{ceff00}~Improvement~Improved dev_console ConVar: can now be opened over loading dialogs"
				"46"		"{ceff00}~Improvement~Improved server browser map filter: added support for exact map name search in quotes"
				"47"		"{ceff00}~Improvement~Added support for custom sizes for the original radar via hud.txt"
				"48"		"{ceff00}~Improvement~Improved DHUD: messages now respect channels (vanilla bug)"
				"49"		"{ceff00}~Improvement~Improved 'hud_headname' ConVar: added mode 2 to display the names of all players with their team color during demo playback"
				"50"		"{ceff00}~Improvement~Added ConVar 'cl_discord_join_mode' to control Discord 'Join Game' functionality (0 = public connection, 1 = friends-only mode respecting Discord privacy settings)"
				"51"		"{ffcc33}~Fix~Fixed round timer disappearing after reconnecting if a bomb was planted in the previous round"
