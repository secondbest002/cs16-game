// ==============================================================================
// EmptyX CS 1.6 Xash3D Optimization & Client Settings
// ==============================================================================
// 1. Prediction & Client Physics
cl_lw 1
cl_lc 1
cl_righthand 1
cl_crosshair_color "0 255 0"
fps_max 144

// 2. Camera & Viewmodel Stability (No screen sway / sea motion sickness)
cl_viewbob 0
sv_rollangle 0
cl_bob 0.01
cl_bobcycle 0.80
cl_bobup 0.50
hud_fastswitch 1

// 3. Inspect Weapon Binding & Aliases
bind "f" "lookatweapon"
alias weaponlookat "lookatweapon"
alias +weaponlookat "+lookatweapon"
alias -weaponlookat "-lookatweapon"
alias inspect "lookatweapon"

echo "[EmptyX] Xash3D FWGS Client Settings Initialized Successfully!"

